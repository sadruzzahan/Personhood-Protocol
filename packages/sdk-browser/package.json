{
  "name": "@proofofperson/browser",
  "version": "0.1.0",
  "description": "Run a Proof of Personhood verification flow in the browser. Opens the hosted liveness check, polls until approved, returns the human badge JWT.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["proof-of-personhood", "browser", "verification", "persona"],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "~5.9.2"
  }
}
