{
  "name": "@proofofperson/server",
  "version": "0.1.0",
  "description": "Verify Proof of Personhood human-badge JWTs against the published JWKS. Server SDK.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["proof-of-personhood", "jwt", "jwks", "rs256", "verification"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^8.4.0",
    "typescript": "~5.9.2"
  }
}
